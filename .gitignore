.DS_Store
.local/
.worktrees/
.claude/worktrees/
# Session lane: live sessions stay local. workbench/sessions/.gitignore keeps
# grilling, handoffs, notepads and recovery contents untracked.
workbench/sessions/*
!workbench/sessions/.gitkeep
!workbench/sessions/.gitignore
!workbench/sessions/HANDOFF-TEMPLATE.md
!workbench/sessions/checkpoints/
!workbench/sessions/grilling/
!workbench/sessions/handoffs/
!workbench/sessions/notepads/
!workbench/sessions/recovery/

# Local secrets (Supabase service role key); never commit
.env
.env.*
!.env.example
