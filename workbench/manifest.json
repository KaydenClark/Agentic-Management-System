        "note": "Historical implementation lineage; the adapted package is not a promoted upstream release."
      }
    }
  },
  "git": {
    "defaultBranch": "main",
    "integrationBranch": "main"
  },
  "lanes": {
    "docs": "workbench/docs",
    "specs": "workbench/specs",
    "wiki": "workbench/wiki",
    "sessions": "workbench/sessions",
    "feedback": "workbench/feedback",
    "tools": "workbench/tools",
    "skills": ".agents/skills"
  },
  "collections": {
    "adr": "workbench/docs/adr",
    "design-concepts": "workbench/wiki/design-concepts",
    "guidebooks": "workbench/wiki/guidebooks",
    "archive": "workbench/wiki/archive",
    "grilling": "workbench/sessions/grilling",
    "handoffs": "workbench/sessions/handoffs",
    "checkpoints": "workbench/sessions/checkpoints",
    "notepads": "workbench/sessions/notepads",
    "notepad-templates": "workbench/sessions/notepads/templates",
    "recovery": "workbench/sessions/recovery",
    "features": "workbench/wiki/features",
    "ddr": "workbench/docs/ddr",
    "landmarks": "workbench/landmarks"
  },
  "wiki": {
    "profile": "project"
  },
  "skillPolicy": {
    "required": [
      "setup-workbench",
      "map",
      "plan",
      "orchestrate",
      "journey",
      "jot",
      "domain-modeling",
      "grilling",
      "code-review",
      "pr",
      "carry",
      "reconcile",
      "improve-workbench",
      "evaluate-workbench",
      "audit-workbench",
      "author-skill"
    ],
    "discovery": [
      ".agents/skills",
      ".claude/skills"
    ],
    "normalSetup": "personal-catalog",
    "updates": "explicit-only"
  },
  "legibility": {
    "run": "[RUN_COMMAND]",
    "operate": "node workbench/tools/spec-workbench.mjs claim S-### --agent NAME; close S-### --agent NAME --proof TEXT --docs TEXT --remaining-gap TEXT",
    "inspect": "node workbench/tools/spec-workbench.mjs list; show S-###; TASKBOARD.md",
    "errors": "node workbench/tools/spec-workbench.mjs doctor --json; git status --porcelain",
    "journey": "[JOURNEY_COMMAND]",
    "measure": "[MEASURE_COMMAND]"
  }
}
