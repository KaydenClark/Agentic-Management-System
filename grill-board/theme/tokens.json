{
  "source": {
    "artifact": "Grilling Board Redesign",
    "version": "1793538932-43c3"
  },
  "themes": {
    "dark": {
      "--ground": "#0A0A0A",
      "--surface": "#191919",
      "--raised": "#232323",
      "--line": "#333333",
      "--line-strong": "#757575",
      "--muted": "#A8A8A8",
      "--ink": "#F7F7F7",
      "--pole": "#FFFFFF",
      "--heat": "#FF5A1F",
      "--worth": "#FFD60A",
      "--owner": "#4C9BE8",
      "--agent": "#3DBE5A",
      "--returned": "#A66BE0",
      "--soft-pct": "22%",
      "--line-pct": "62%",
      "--dot-pct": "80%"
    },
    "light": {
      "--ground": "#F7F7F7",
      "--surface": "#FFFFFF",
      "--raised": "#EFEFEF",
      "--line": "#E0E0E0",
      "--line-strong": "#808080",
      "--muted": "#474747",
      "--ink": "#0A0A0A",
      "--pole": "#000000",
      "--heat": "#F04E12",
      "--worth": "#F5C400",
      "--owner": "#2F86DC",
      "--agent": "#27A046",
      "--returned": "#A66BE0",
      "--soft-pct": "22%",
      "--line-pct": "68%",
      "--dot-pct": "72%"
    }
  },
  "meanings": {
    "--ground": "Page background",
    "--surface": "Panels, cards and inputs",
    "--raised": "Hover, the selected item and progress tracks",
    "--line": "Hairline dividers",
    "--line-strong": "Control borders; grey, nothing for you here",
    "--muted": "Secondary text",
    "--ink": "Primary text, grade badges and progress",
    "--pole": "Mixing anchor for tone text, outlines and dots",
    "--heat": "Trouble: a failed write, a blocker or a conflict",
    "--worth": "Why an answer is worth the owner's time",
    "--owner": "It waits on the owner",
    "--agent": "Agents carry it, or it is the agents' voice",
    "--returned": "It came back for rework",
    "--soft-pct": "Tint strength of a hue at rest",
    "--line-pct": "Hue strength of a tone outline",
    "--dot-pct": "Hue strength of a tone dot"
  },
  "mixes": {
    ".tone": {
      "--on": "#0A0A0A",
      "--tone-soft": "color-mix(in oklab,var(--hue) var(--soft-pct),var(--surface))",
      "--tone-ink": "color-mix(in oklab,var(--hue) 40%,var(--pole))",
      "--tone-line": "color-mix(in oklab,var(--hue) var(--line-pct),var(--pole))",
      "--tone-dot": "color-mix(in oklab,var(--hue) var(--dot-pct),var(--pole))"
    },
    ".h-heat": {
      "--hue": "var(--heat)"
    },
    ".h-worth": {
      "--hue": "var(--worth)"
    },
    ".h-owner": {
      "--hue": "var(--owner)"
    },
    ".h-agent": {
      "--hue": "var(--agent)"
    },
    ".h-returned": {
      "--hue": "var(--returned)"
    },
    ".h-none": {
      "--hue": "var(--line-strong)"
    }
  }
}
